# inception environment variables (non-secret values)
# Secrets live in secrets/*.txt and are mounted via Docker secrets

# --- Infastructure ---
DOMAIN_NAME=${USER}.42.fr
DATA_DIR=/home/${USER}/data

# --- MariaDB ---
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user

# --- WordPress ---
WP_TITLE=Inception Site
WP_ADMIN_USER=chief
WP_ADMIN_EMAIL=chief@${DOMAIN_NAME}
WP_USER=editor
WP_USER_EMAIL=editor@${DOMAIN_NAME}

# --- Nginx ---
HTTPS_PORT=443
